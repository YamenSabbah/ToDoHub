# =====================================
# ToDo Hub - Environment Variables
# =====================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# --- Database ---
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/todohub"

# --- Authentication ---
# Secret key used to sign and verify JWT tokens
# Generate a strong random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET="your-super-secret-key-change-this"

# JWT token expiration time (optional, defaults to "1d")
# Examples: "1h", "7d", "30d"
JWT_EXPIRES_IN="1d"

# --- Environment ---
# Set to "production" for secure cookies, or leave blank for development
NODE_ENV="development"
